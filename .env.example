# Шаблон переменных окружения для подключения к PostgreSQL
# Скопируйте этот файл в .env и заполните значения под своё окружение:
#   copy .env.example .env

DB_HOST=localhost
DB_PORT=5432
DB_NAME=booking
DB_USER=your_user
DB_PASSWORD=your_password

# Тестовая база (только для интеграционных тестов).
# Должна отличаться от DB_NAME и оканчиваться на "_test".
TEST_DB_NAME=booking_test
